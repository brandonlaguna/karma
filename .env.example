# =========================
# GENERAL
# =========================

NODE_ENV=

# Proveedor del modelo de chat para ai-backend: "ollama" (local, sin
# costo) o "openai" (API real de OpenAI, de pago -- ver CHAT_MODEL más
# abajo). OJO con "openai": el JSON crudo de cada alerta y resultados de
# tools (IPs, dispositivos, traceroutes) salen a la API de OpenAI --
# confirmar que sea aceptable para los clientes antes de usarlo en
# producción.
AI_PROVIDER=

# =========================
# OPENAI
# =========================

OPENAI_API_KEY=

# =========================
# OLLAMA
# =========================

# Ollama corre dentro de WSL (Ubuntu), no en Windows: host.docker.internal
# pasa por el relay de Windows (solo loopback) y rechaza la conexión. Se usa la
# IP de WSL (`hostname -I` en Ubuntu, primera). OJO: esa IP puede cambiar al
# reiniciar el equipo -- si de repente da "Connection error", actualízala aquí.
OLLAMA_BASE_URL=
# OLLAMA_KEEP_ALIVE NO va acá -- Ollama corre nativo en el host, no
# dentro de docker-compose, así que esta variable no lo alcanza desde
# este archivo. Para que el modelo no se descargue de RAM entre
# pruebas, hay que exportarla donde corre `ollama serve` en el
# servidor (ej. en el systemd unit de ollama), con algo como:
#   Environment="OLLAMA_KEEP_ALIVE=30m"

# =========================
# BACKEND
# =========================

BACKEND_PORT=
# Tope de rondas de tool-calling por conversación en /chat (evita loops
# infinitos si el modelo se queda pidiendo tools sin parar).
MAX_TOOL_ITERATIONS=
# Cuánto tiempo se cachea en memoria la lista de tools del mcp-server
# antes de volver a pedirla (evita un round-trip MCP completo en cada
# mensaje del chat). Bájalo si agregas tools seguido y quieres verlas
# reflejadas rápido sin reiniciar el contenedor.
TOOLS_CACHE_TTL_MINUTES=
# Cuánto tiempo se mantiene en memoria el historial de una conversación
# desde su último mensaje, antes de olvidarse sola (evita que crezca sin
# límite si nadie cierra el chat). Vive en memoria del proceso -- si
# ai-backend se reinicia, se pierde el historial activo.
CONVERSATION_TTL_MINUTES=
# Tope de turnos (preguntas del usuario) que se guardan por
# conversación -- una conversación larga se pone más lenta con cada
# turno (más contexto que procesar), así que se recorta a los últimos
# N turnos en vez de dejarla crecer sin límite. 8 es un punto medio
# entre los 5-10 que pidió Victor.
MAX_CONVERSATION_TURNS=

# =========================
# CONTEXT WINDOW (preparado, aún NO conectado al flujo real -- ver
# backend/src/contextBudget.ts)
# =========================

# Presupuesto aproximado de tokens por conversación, alternativa al
# recorte por MAX_CONVERSATION_TURNS de arriba (ese es por cantidad de
# turnos, ciego al tamaño real de cada uno -- un turno con JSON de
# alerta + graphData + traceroute pesa mucho más que un "¿está
# resuelto?"). Por ahora esta variable no se lee en ningún lado del
# código -- queda declarada y lista para cuando se decida activarla.
MAX_CONTEXT_TOKENS=

# =========================
# MCP SERVER
# =========================

MCP_PORT=
# URL que usa ai-backend para hablarle al mcp-server por el protocolo
# MCP real (endpoint único /mcp, Streamable HTTP). "mcp-server" es el
# nombre del servicio en docker-compose -- se resuelve por DNS interno.
MCP_SERVER_URL=
# EpistechBackend está en un docker-compose SEPARADO (proyecto distinto),
# pero en el mismo host y en la misma red externa "net_container" --
# por eso se puede resolver por el container_name real. OJO (corregido
# 2026-08-06): el nombre real es "epistech-backend" con GUION, tomado
# del docker-compose.yml que de verdad está en uso (EPISTECH/docker-
# compose.yml) -- EpistechBackend/docker-compose.yml (con guion bajo)
# es un archivo viejo/sin usar, confirmar siempre contra `docker ps`.
EPISTECH_BACKEND_URL=

# =========================
# POSTGRESQL
# =========================

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# =========================
# REDIS
# =========================

REDIS_HOST=
REDIS_PORT=

# =========================
# QDRANT
# =========================

QDRANT_URL=
# Colección donde vive la base de conocimiento del NOC (ver
# mcp-server/knowledge-base/). Se crea sola la primera vez que se corre
# el ingest o se llama la tool search_knowledge_base.
QDRANT_COLLECTION=

# =========================
# OPEN WEBUI
# =========================

WEBUI_SECRET_KEY=


# =========================
# JWT / AUTH (endpoints de escritura de la matriz RACI en mcp-server)
# =========================

# Debe ser EXACTAMENTE el mismo JWT_SECRET de EpistechBackend: ai-lab valida
# los tokens (HS256) que emite EPISTECH, no emite los suyos. El valor de
# abajo es un placeholder -- reemplázalo por el real en cada ambiente.
JWT_SECRET=
# false (o vacío) = modo permisivo: se valida el token pero SIEMPRE se deja
# pasar y solo se avisa en el log. true = rechaza con 401/403.
# Pasar a true antes de exponer mcp-server fuera de la red local.
AUTH_ENFORCE=
# Claims requeridos para escribir en la matriz (separados por coma, ej.
# CLAIMS de usuario en EPISTECH). Vacío = basta con estar autenticado.
ESCALATION_WRITE_CLAIMS=

# =========================
# EMBEDDINGS
# =========================

# Proveedor de embeddings: "openai" (text-embedding-3-small, 1536 dim,
# multilingüe -- los documentos y consultas salen a OpenAI, usa OPENAI_API_KEY)
# u "ollama" (local, sin costo, pero nomic-embed-text está pensado para inglés
# y con documentos en español la búsqueda falla con paráfrasis; requiere
# `ollama pull nomic-embed-text`).
# Al CAMBIAR proveedor/modelo hay que borrar la colección de Qdrant y volver a
# correr la ingesta (pnpm run ingest): cambia el tamaño del vector.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# =========================
# CHAT MODEL (OpenAI, solo si AI_PROVIDER=openai)
# =========================

CHAT_MODEL=

# =========================
# LOCAL MODEL
# =========================

LOCAL_MODEL=
# =========================
# ANTHROPIC / CLAUDE (solo si AI_PROVIDER=anthropic)
# =========================
# Con AI_PROVIDER=anthropic el chat usa Claude (SDK oficial). La clave va SOLO
# aquí, nunca en el chat ni en git. OJO: el JSON crudo de cada alerta y los
# resultados de las tools salen a la API de Anthropic -- confirmar que sea
# aceptable para el cliente. Las embeddings de la base de conocimiento son
# independientes (EMBEDDING_PROVIDER): Claude no genera embeddings.
ANTHROPIC_API_KEY=
# Modelo del chat (default claude-sonnet-5-5: buen equilibrio entre calidad y
# latencia con tools; claude-opus-5-5 es más capaz y más lento/caro,
# claude-haiku-5-5 es el más rápido y barato).
ANTHROPIC_CHAT_MODEL=
# Tope de tokens de salida por respuesta (default 4096) y timeout por llamada en
# ms (default 55000: EpistechBackend corta el proxy a los 120 s).
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_TIMEOUT_MS=

# =========================
# FUENTES (vendors) QUE USA ESTE DESPLIEGUE
# =========================
# Qué fuentes de monitoreo tienen tools en el chat, separadas por coma: zabbix, opmanager. Vacío = todas.
# Cada cliente monitorea SU stack: con "zabbix" el modelo NO ve las tools de OpManager (traceroute, gráficas,
# notas de dispositivo), no las ofrece ni falla al intentarlas, y cada mensaje gasta menos tokens.
# Fusionet: zabbix. Atento: opmanager.
ENABLED_VENDORS=
